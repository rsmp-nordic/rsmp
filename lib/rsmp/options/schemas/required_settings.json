{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Validate after applying defaults and inherited site settings; structural validation uses the other config schemas.",
  "type": "object",
  "properties": {
    "components": { "type": "object" },
    "signal_plans": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["cycle_time"]
      }
    }
  },
  "if": {
    "required": ["connection_role"],
    "properties": { "connection_role": { "const": "server" } }
  },
  "then": { "required": ["port"] },
  "allOf": [
    {
      "if": {
        "required": ["core_version"],
        "properties": { "core_version": { "const": "3.3.0" } }
      },
      "else": {
        "properties": {
          "components": {
            "required": ["main"],
            "properties": {
              "main": { "type": "object", "minProperties": 1, "maxProperties": 1 }
            }
          }
        }
      }
    }
  ]
}
